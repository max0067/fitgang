# Configuration de l'environnement FitGang
# Copier ce fichier en .env et remplir avec vos vraies valeurs

# Clé secrète Flask (générer une clé aléatoire sécurisée)
SECRET_KEY=your-secret-key-here

# Base de données (laisser vide pour SQLite par défaut)
# DATABASE_URL=sqlite:///fitgang.db

# Clés Stripe (mode test)
STRIPE_PUBLIC_KEY=pk_test_your_public_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# URL de base (pour les webhooks)
BASE_URL=http://localhost:5000

# Environnement
FLASK_ENV=development
FLASK_APP=run.py

# Configuration Email (pour envoi d'emails et campagnes newsletter)
MAIL_SERVER=mail.fitgang.fr
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_USERNAME=admin@fitgang.fr
MAIL_PASSWORD=your_email_password_here
MAIL_DEFAULT_SENDER=admin@fitgang.fr
ADMIN_EMAIL=admin@fitgang.fr
