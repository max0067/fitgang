# Configuration de production pour Hostinger
# Copier ce fichier en .env sur le serveur Hostinger

# Clé secrète Flask (GÉNÉRER UNE NOUVELLE CLÉ AVEC: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=GENERER_UNE_NOUVELLE_CLE_SECRETE_ICI

# Base de données
# Pour SQLite (simple, mais moins performant)
DATABASE_URL=sqlite:///fitgang.db

# OU pour MySQL (recommandé en production)
# DATABASE_URL=mysql+pymysql://username:password@localhost/database_name

# Clés Stripe LIVE (PAS LES CLÉS DE TEST!)
# Va sur stripe.com > Developers > API keys et utilise les clés LIVE
STRIPE_PUBLIC_KEY=pk_live_VOTRE_CLE_PUBLIQUE_LIVE
STRIPE_SECRET_KEY=sk_live_VOTRE_CLE_SECRETE_LIVE
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK

# URL de base (ton vrai domaine)
BASE_URL=https://fitgang.fr

# Environnement
FLASK_ENV=production
FLASK_APP=run.py

# Options de production
FLASK_DEBUG=False
